# Public (sent to the browser; only NEXT_PUBLIC_* are safe)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic / Gateway. Prefer AI Gateway (Vercel OIDC inside a deploy, or
# AI_GATEWAY_API_KEY locally); ANTHROPIC_API_KEY is the fallback when neither
# is present (e.g. `npm run dev` against a personal key).
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# Model slugs (override per role; defaults match backend/app/gating.py)
MODEL_ANALYSIS=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5
MODEL_VISION=claude-sonnet-4-6

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Internal Python backend (server-to-server bearer; same value as
# KNOW_INTERNAL_BACKEND_TOKEN on the backend)
INTERNAL_BACKEND_URL=https://your-backend.example.com
INTERNAL_BACKEND_TOKEN=

# Vercel KV (auto-injected on Vercel deploys with KV linked)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron secret (for /api/cron/* auth)
CRON_SECRET=
