KNOW_ANTHROPIC_API_KEY=
KNOW_CORS_ORIGINS=https://your-app.vercel.app

# Clerk authentication
KNOW_CLERK_SECRET_KEY=
KNOW_CLERK_JWKS_URL=
KNOW_CLERK_ISSUER=
KNOW_CLERK_AUDIENCE=

# Supabase
KNOW_SUPABASE_URL=
KNOW_SUPABASE_KEY=

# Stripe
KNOW_STRIPE_SECRET_KEY=
KNOW_STRIPE_WEBHOOK_SECRET=
KNOW_STRIPE_PRICE_SCHOLAR=
KNOW_STRIPE_PRICE_RESEARCHER=

# Internal bearer token for /api/internal/* — shared with the Next.js
# deployment (set the same value in Vercel as INTERNAL_BACKEND_TOKEN).
# Must be a strong random string; the Next.js streaming routes use this
# to call back for paper context, usage reservation, and figure bytes.
# Reused as the bearer when Python calls back into Vercel (rate-check).
KNOW_INTERNAL_BACKEND_TOKEN=

# Optional: Vercel deploy URL for the KV-backed trial rate limiter
# (Stage 6). Set after the Next.js /api/trial/rate-check route is
# deployed. Leave empty to keep using the Supabase RPC only.
KNOW_NEXTJS_RATELIMIT_URL=https://your-app.vercel.app

# Set to "1" once Vercel Cron at /api/cron/cleanup-trial is verified
# running, to disable the legacy in-process trial cleanup loop.
KNOW_DISABLE_INTERNAL_CRON_FALLBACK=
